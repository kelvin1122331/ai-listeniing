# Copy to .env.local. Never commit real credentials.
# Required to answer using Gemini:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live

# Optional admin access. No default username or password is enabled.
ADMIN_USERNAME=
# At least 12 characters:
ADMIN_PASSWORD=
# Generate two DIFFERENT random secrets, each at least 32 characters:
ADMIN_SESSION_SECRET=
CONFIG_ENCRYPTION_KEY=

# Optional OpenAI-compatible providers (activate through the admin panel):
OPENAI_API_KEY=
CUSTOM_API_KEY=
CUSTOM_BASE_URL=

# For deployments behind a reverse proxy, set the exact public origin:
# APP_ORIGIN=https://aura.example.com
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Local HTTP production testing only; omit on HTTPS deployments.
# COOKIE_SECURE=false
